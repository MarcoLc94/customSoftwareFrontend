---
import { services } from '../data';
---
<div class="service-grid">{services.map((s,i)=><a class="service-card" href={`/servicios/${s.slug}`}><div class="card-top"><span class="service-icon" aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={i===0 ? "M3 4h18v16H3zM3 9h18M7 6.5h.01M10 6.5h.01" : i===1 ? "m8 6-6 6 6 6m8-12 6 6-6 6m-3-14-2 16" : i===2 ? "M3 3h7v7H3zm11 0h7v7h-7zM3 14h7v7H3zm11 0h7v7h-7z" : "m13 2-9 12h7l-1 8 10-13h-8z"} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><span class="micro">0{i+1} / {s.short}</span></div><h3>{s.name}</h3><p>{s.text}</p><span class="text-link">Explorar servicio <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span></a>)}</div>
