---
import '../styles/global.css';
import '../styles/experience.css';
import { ClientRouter } from 'astro:transitions';
import BrandLogo from '../components/BrandLogo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import WhatsApp from '../components/WhatsApp.astro';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = 'Desarrollo web y software a medida en Monterrey', description = 'Soy Marco, desarrollador de páginas web, software a medida e inventarios. Trabaja directamente conmigo desde la idea hasta el lanzamiento. Monterrey, México.', noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const nav = [['/', 'Inicio'], ['/servicios', 'Servicios'], ['/#proyectos', 'Proyectos'], ['/proceso', 'Proceso'], ['/contacto', 'Contacto'], ['/aviso-de-privacidad', 'Privacidad']];
---
<!doctype html>
<html lang="es-MX" data-theme="dark" transition:animate="none">
<head>
<meta charset="UTF-8"/>
<ClientRouter fallback="swap"/>
<script is:inline>
(() => {
  const savedTheme = () => { try { const value = localStorage.getItem('theme'); return value === 'light' || value === 'dark' ? value : 'dark'; } catch { return 'dark'; } };
  const applyTheme = (theme, target = document) => {
    target.documentElement.dataset.theme = theme;
    target.documentElement.dataset.js = 'true';
    target.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#101824' : '#f8f7f3');
    target.querySelectorAll('.theme-toggle').forEach(button => {
      button.setAttribute('aria-label', `Cambiar a modo ${theme === 'dark' ? 'claro' : 'oscuro'}`);
      button.setAttribute('aria-pressed', String(theme === 'dark'));
    });
  };
  applyTheme(savedTheme());
  document.addEventListener('astro:before-swap', event => applyTheme(document.documentElement.dataset.theme, event.newDocument));
  document.addEventListener('astro:page-load', () => applyTheme(document.documentElement.dataset.theme));
  document.addEventListener('click', event => {
    if (!(event.target instanceof Element) || !event.target.closest('.theme-toggle')) return;
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(theme);
    try { localStorage.setItem('theme', theme); } catch {}
  });
  window.addEventListener('storage', event => { if (event.key === 'theme') applyTheme(savedTheme()); });
})();
</script><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title} | Marco Dev</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
{noindex && <meta name="robots" content="noindex, follow"/>}
<meta name="theme-color" content="#f8f7f3"/>
<link rel="icon" href="/favicon.ico" sizes="any"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<meta name="facebook-domain-verification" content="wbbqc0q30jonl31mjkoxplgfpxe4mi"/><meta name="facebook-domain-verification" content="z1sej6yqj42bv5wdu9mtggemnd2dze"/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Marco Dev"/><meta property="og:title" content={`${title} | Marco Dev`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="es_MX"/><meta property="og:image" content="https://marcodev.com.mx/social-cover.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={`${title} | Marco Dev`}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content="https://marcodev.com.mx/social-cover.png"/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'ProfessionalService',name:'Marco Dev',url:'https://marcodev.com.mx',telephone:'+528118474519',email:'mlop.dev@outlook.com',address:{'@type':'PostalAddress',addressLocality:'Guadalupe',addressRegion:'Nuevo León',addressCountry:'MX'},areaServed:'México',description})}/>
